FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPYCACHEPREFIX=/tmp/pycache \
    RUFF_CACHE_DIR=/tmp/ruff-cache \
    MYPY_CACHE_DIR=/tmp/mypy-cache

WORKDIR /app

RUN useradd --create-home --shell /usr/sbin/nologin appuser

COPY pyproject.toml ./
COPY backend ./backend
COPY tests ./tests

RUN pip install --upgrade pip && \
    pip install -e ".[dev]"

RUN mkdir -p \
    /tmp/pycache \
    /tmp/ruff-cache \
    /tmp/mypy-cache \
    /tmp/pytest-cache && \
    chown -R appuser:appuser /tmp/pycache \
    /tmp/ruff-cache \
    /tmp/mypy-cache \
    /tmp/pytest-cache

USER appuser

CMD ["pytest", "-q", "--cache-dir=/tmp/pytest-cache"]